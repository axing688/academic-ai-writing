{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://academic-ai-writing-production.up.railway.app/api/:path*"
    },
    {
      "source": "/llm/:path*",
      "destination": "https://REPLACE-WITH-YOUR-WORKER-HOST/llm/:path*"
    },
    {
      "source": "/((?!api|llm).*)",
      "destination": "/index.html"
    }
  ]
}
