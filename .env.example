# 环境变量配置示例

# DashScope API Key（docker-compose 中 ${DASHSCOPE_API_KEY} 引用，用于后端真实 AI 能力）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=academic_writing
DB_CHARSET=utf8mb4

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI 服务配置
AI_API_KEY=your_dashscope_api_key_here
AI_MODEL=qwen-14b-chat
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# JWT 配置
JWT_SECRET_KEY=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_HOST=0.0.0.0

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=.docx,.txt,.md,.pdf

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# 跨域配置
CORS_ENABLED=true
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,Content-Type,Authorization,X-Requested-With

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour in seconds

# 监控配置
METRICS_ENABLED=false
METRICS_PORT=9090

# 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@academic-writing-assistant.com

# 开发模式配置
DEBUG_MODE=true
DEBUG_PORT=4000

# 测试配置
TEST_DATABASE_URL=sqlite3://./test.db
TEST_REDIS_URL=redis://localhost:6379/1